{
  "name": "cocos-backend-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend challenge for Cocos",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/**/*.e2e.test.ts",
    "test:integration": "npm run test:e2e",
    "test:e2e": "vitest run tests/api.e2e.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.26",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
